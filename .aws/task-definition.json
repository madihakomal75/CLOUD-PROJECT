{
  "family": "nodebase-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::914179697087:role/nodebase-exec-role",
  "taskRoleArn": "arn:aws:iam::914179697087:role/nodebase-task-role",
  "containerDefinitions": [
    {
      "name": "nodebase-container",
      "image": "914179697087.dkr.ecr.us-east-1.amazonaws.com/nodebase-app-repo:latest",
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        { "name": "PORT", "value": "3000" },
        { "name": "HOSTNAME", "value": "0.0.0.0" },
        { "name": "AUTH_TRUST_HOST", "value": "true" },
        { "name": "BETTER_AUTH_URL", "value": "http://nodebase-alb-218677172.us-east-1.elb.amazonaws.com" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/nodebase-app",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}