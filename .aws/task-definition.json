{
  "family": "nodebase-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::914179697087:role/nodebase-exec-role",
  "taskRoleArn": "arn:aws:iam::914179697087:role/nodebase-task-role",
  "containerDefinitions": [
    {
      "name": "nodebase-container",
      "image": "914179697087.dkr.ecr.us-east-1.amazonaws.com/nodebase-app-repo:latest",
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
        
      ],
      "essential": true,
      "environment": [
        { "name": "PORT", "value": "3000" },
        { "name": "HOSTNAME", "value": "0.0.0.0" },
        { "name": "DATABASE_URL", "value": "postgresql://postgres:medipack00%23@nodebase-db-final.cg9iwm4ea0i7.us-east-1.rds.amazonaws.com:5432/nodebase" },
        { "name": "NEXT_PUBLIC_APP_URL", "value": "http://nodebase-alb-218677172.us-east-1.elb.amazonaws.com" },
        { "name": "AWS_BUCKET_NAME", "value": "cloud-project-26-final" },
        { "name": "AWS_REGION", "value": "us-east-1" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/nodebase-app",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}