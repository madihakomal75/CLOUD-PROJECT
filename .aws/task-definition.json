{
  "name": "nodebase-container",
  "image": "914179697087.dkr.ecr.us-east-1.amazonaws.com/nodebase-app:latest",
  "cpu": 0,
  "portMappings": [
    {
      "containerPort": 3000,
      "hostPort": 3000,
      "protocol": "tcp",
      "name": "nodebase-container-3000-tcp",
      "appProtocol": "http"
    }
  ],
  "essential": true,
  "environment": [
    {
      "name": "GITHUB_CLIENT_ID",
      "value": "dummy_id"
    },
    {
      "name": "PORT",
      "value": "3000"
    },
    {
      "name": "AWS_BUCKET_NAME",
      "value": "cloud-project-26"
    },
    {
      "name": "NEXT_PUBLIC_ENCRYPTION_KEY",
      "value": "super_secret_password_123"
    },
    {
      "name": "NEXT_PUBLIC_APP_URL",
      "value": "http://nodebase-alb-107462961.us-east-1.elb.amazonaws.com"
    },
    {
      "name": "GITHUB_CLIENT_SECRET",
      "value": "dummy_secret"
    },
    {
      "name": "AUTH_TRUST_HOST",
      "value": "true"
    },
    {
      "name": "ENCRYPTION_KEY",
      "value": "super_secret_password_123"
    },
    {
      "name": "BETTER_AUTH_URL",
      "value": "http://nodebase-alb-107462961.us-east-1.elb.amazonaws.com"
    },
    {
      "name": "DATABASE_URL",
      "value": "postgresql://postgres:medipack00%23@nodebase-db.cg9iwm4ea0i7.us-east-1.rds.amazonaws.com:5432/postgres"
    },
    {
      "name": "HOSTNAME",
      "value": "0.0.0.0"
    },
    {
      "name": "ENCRYPTION_SECRET",
      "value": "super_secret_password_123"
    },
    {
      "name": "BETTER_AUTH_SECRET",
      "value": "http://nodebase-alb-107462961.us-east-1.elb.amazonaws.com"
    }
  ],
  "mountPoints": [],
  "volumesFrom": [],
  "logConfiguration": {
    "logDriver": "awslogs",
    "options": {
      "awslogs-group": "/ecs/nodebase-task",
      "awslogs-region": "us-east-1",
      "awslogs-stream-prefix": "ecs"
    },
    "secretOptions": []
  },
  "healthCheck": {
    "command": [
      "CMD-SHELL",
      "curl -f http://localhost:3000/ || exit 0"
    ],
    "interval": 30,
    "timeout": 10,
    "retries": 5,
    "startPeriod": 120
  },
  "systemControls": []
}