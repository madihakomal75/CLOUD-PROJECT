# ---- Stage 1: Build ----
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps

# 1. ADD THIS LINE: Copy your prisma schema folder so the builder can see it
COPY prisma/ ./prisma/

COPY workers/ ./workers/
COPY workers/tsconfig.json ./workers/tsconfig.json
COPY tsconfig.json ./tsconfig.json

# 2. ADD THIS LINE: Generate the Prisma client engines
RUN npx prisma generate

RUN npx tsc -p workers/tsconfig.json
RUN test -f dist/task-handler.js || (echo "ERROR: dist/task-handler.js not found" && exit 1)

# ---- Stage 2: Lambda runtime image ----
FROM amazon/aws-lambda-nodejs:20

WORKDIR ${LAMBDA_TASK_ROOT}

COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps --omit=dev

# 3. ADD THESE LINES: Copy prisma schema and generated client files into the runner
COPY prisma/ ./prisma/
COPY --from=builder /app/node_modules/.prisma ${LAMBDA_TASK_ROOT}/node_modules/.prisma

COPY --from=builder /app/dist ${LAMBDA_TASK_ROOT}/dist

CMD ["dist/task-handler.handler"]