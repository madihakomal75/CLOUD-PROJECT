FROM public.ecr.aws/lambda/nodejs:22

# Lambda environment root
WORKDIR ${LAMBDA_TASK_ROOT}

# Copy dependency files and Prisma schema
COPY package*.json ./
COPY prisma ./prisma/

# Install dependencies and generate Prisma client for the Lambda environment
RUN npm install --legacy-peer-deps
RUN npx prisma generate

# Copy the rest of the application code
COPY . .

# Compile TypeScript using your worker's specific config
RUN npx tsc --project workers/tsconfig.json

# Remove development dependencies to keep the image lean
RUN npm prune --production --legacy-peer-deps

# Point to your compiled handler (e.g., dist/workers/handler.js)
CMD [ "dist/workers/handler.handler" ]