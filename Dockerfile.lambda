# ---- Stage 1: Build & Generate inside the matching Lambda environment ----
FROM amazon/aws-lambda-nodejs:20 AS builder

WORKDIR /app

# Copy dependency files
COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps

# Copy prisma structure and source code
COPY prisma/ ./prisma/
COPY workers/ ./workers/
COPY workers/tsconfig.json ./workers/tsconfig.json
COPY tsconfig.json ./tsconfig.json

# Force Prisma to generate binaries compatible with AWS Lambda execution
RUN npx prisma generate

# Compile TypeScript files
RUN npx tsc -p workers/tsconfig.json
RUN test -f dist/task-handler.js || (echo "ERROR: dist/task-handler.js not found" && exit 1)

# ---- Stage 2: Final Clean Lambda Execution Layer ----
FROM amazon/aws-lambda-nodejs:20

WORKDIR ${LAMBDA_TASK_ROOT}

COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps --omit=dev

# Copy generated Prisma Client and schema engines from builder cleanly
COPY --from=builder /app/prisma/ ./prisma/
COPY --from=builder /app/node_modules/.prisma ${LAMBDA_TASK_ROOT}/node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ${LAMBDA_TASK_ROOT}/node_modules/@prisma

# Copy built production javascript code
COPY --from=builder /app/dist ${LAMBDA_TASK_ROOT}/dist

CMD ["dist/task-handler.handler"]