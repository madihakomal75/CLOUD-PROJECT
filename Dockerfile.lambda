FROM public.ecr.aws/lambda/nodejs:22

WORKDIR ${LAMBDA_TASK_ROOT}

COPY package*.json ./
COPY prisma ./prisma/

ENV PRISMA_SKIP_POSTINSTALL_GENERATE=true
RUN npm install --legacy-peer-deps

COPY . .

# Generate Prisma and build
RUN npx prisma generate
RUN npm run build

# If you are using the Next.js standalone server for the worker:
CMD [ "server.handler" ] 
# Note: Ensure your server.js exports a 'handler' for Lambda.